{
  "name": "next-cache-handlers",
  "version": "2.0.0",
  "description": "Redis cache handler for Next.js cacheHandlers (\"use cache\")",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "typesafe",
    "typescript",
    "cache",
    "nextjs"
  ],
  "author": "Mattia Dalzocchio <mattiadalzocchio@me.com>",
  "homepage": "https://github.com/uxio-labs/next-cache-handlers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxio-labs/next-cache-handlers.git"
  },
  "bugs": {
    "url": "https://github.com/uxio-labs/next-cache-handlers/issues"
  },
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "import": "./dist/redis.js",
      "default": "./dist/redis.js"
    },
    "./redis-env": {
      "types": "./dist/redis-env.d.ts",
      "import": "./dist/redis-env.js",
      "default": "./dist/redis-env.js"
    }
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "dev": "rm -rf dist && tsdown --watch",
    "build": "tsdown --minify",
    "test": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": "^16",
    "redis": "^5"
  },
  "peerDependenciesMeta": {
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/redis": "11.14.0",
    "@types/node": "26.1.2",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "redis": "5.12.1",
    "testcontainers": "11.14.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
